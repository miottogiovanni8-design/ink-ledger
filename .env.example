# Alpaca — paper trading account (create at https://alpaca.markets)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Anthropic — used by the view-generation engine (separate from any Claude Code usage)
ANTHROPIC_API_KEY=

# News (Finnhub — https://finnhub.io: per-asset headlines + general market news)
# and market cap for the BL equilibrium prior
FINNHUB_API_KEY=

# Optional secondary sentiment source (Alpha Vantage — https://www.alphavantage.co
# free tier: 25 requests/day, so this only runs for equities, not ETFs)
ALPHAVANTAGE_API_KEY=

# Email recap (Resend — https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TO=

# Portfolio construction
ACTIVE_RISK_PROFILE=balanced   # conservative | balanced | aggressive
MAX_WEIGHT_PCT=0.15
VAR_CONFIDENCE_LEVEL=0.95
MAX_DRAWDOWN_CIRCUIT_BREAKER_PCT=0.18
MIN_TRADE_USD=5

# Paths
DB_PATH=data/trading_desk.sqlite
SNAPSHOT_PATH=data/dashboard_snapshot.json
