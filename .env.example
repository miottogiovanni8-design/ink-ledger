# Alpaca — paper trading account (create at https://alpaca.markets)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Anthropic — used by the decision engine (separate from any Claude Code usage)
ANTHROPIC_API_KEY=

# News / sentiment
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=

# Email recap (Resend — https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TO=

# Risk configuration
DAILY_BUDGET_EUR=100
MAX_POSITION_PCT_OF_BUDGET=0.15
MAX_CONCURRENT_POSITIONS=5
DAILY_LOSS_CIRCUIT_BREAKER_PCT=1.0
MAX_DRAWDOWN_CIRCUIT_BREAKER_PCT=0.18
STOP_LOSS_ATR_MULTIPLIER=1.5
TAKE_PROFIT_RR_RATIO=1.75

# Paths
DB_PATH=data/trading_desk.sqlite
SNAPSHOT_PATH=data/dashboard_snapshot.json
